# Project Goodman Environment Variables Example
# Copy to $GOODMAN_PROD_DIR/.env and fill in your values

# =============================================================================
# LLM Configuration
# =============================================================================
# Primary API key (supports OpenAI, Azure OpenAI, or compatible providers)
LLM_API_KEY="your-api-key"

# Optional: Custom base URL for API endpoint
# - Azure OpenAI: https://your-resource.openai.azure.com
# - Local Ollama: http://localhost:11434/v1
# - Other compatible APIs: their base URL
LLM_BASE_URL=""

# Model overrides (optional - defaults shown)
# LLM_MODEL_CHAT="gpt-4o"
# LLM_MODEL_EXTRACTION="gpt-5-mini"
# LLM_MODEL_EMBEDDING="text-embedding-3-small"
# LLM_MODEL_TITLE="gpt-4o-mini"
# LLM_MODEL_REPORT="gpt-4o"

# Legacy: OPENAI_API_KEY is still supported for backward compatibility
# OPENAI_API_KEY="your-openai-api-key"

# =============================================================================
# Supabase Configuration
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key for admin operations (migrations, DDL) - KEEP SECURE!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# Admin Configuration
# =============================================================================
# Password for admin features (structured data upload, database management)
# This password unlocks admin mode via easter egg trigger (triple-click on page header)
ADMIN_PASSWORD="your-admin-password"

# =============================================================================
# Redis Configuration (V3.2 Security Enhancement)
# =============================================================================
# Required for rate limiting, session management, and brute-force protection
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
# Set to "true" to disable Redis and use in-memory fallback only
# REDIS_DISABLED="false"

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
SENTRY_DSN="https://public-key@oXXXX.ingest.sentry.io/XXXX"
SENTRY_ENV="production"
# Performance tracing sample rate (0-1). Default: 0 (disabled)
SENTRY_TRACES_SAMPLE_RATE="0"

# =============================================================================
# Quality Gates (Perf Baselines)
# =============================================================================
# Enable perf test mode for deterministic API responses (non-production only)
PERF_TEST_MODE="false"
# Set to "false" to allow gates to warn without failing
QUALITY_GATES_STRICT="true"

# =============================================================================
# LangSmith Configuration (Optional - Agent Observability)
# =============================================================================
# Enable tracing to LangSmith for agent workflow observability
# Set to "true" to enable, "false" or omit to disable
LANGCHAIN_TRACING_V2="false"
# API key from LangSmith dashboard (https://smith.langchain.com/)
LANGCHAIN_API_KEY=""
# Project name in LangSmith (defaults to "goodman" if not set)
LANGCHAIN_PROJECT="goodman"

# =============================================================================
# Environment
# =============================================================================
NODE_ENV="development"
