# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prompt files - now committed to repo for Vercel deployment
# (previously excluded as "sensitive business content" but needed for production)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test files and debug outputs
test-*.ts
test_*.ts
test_*.json
verify-*.ts
!verify-unified-agent.ts
verify-*.js
quick-*.ts
check-*.ts
debug_*.txt
debug_*.xlsx
.lighthouseci

# data directory (ignore contents but keep structure)
/data/**/*
!/data/**/
!/data/**/.keep

# supabase
supabase/.temp/

# claude code (user-specific settings)
.claude/settings.local.json

# git worktrees (local)
.worktrees/
.a11y

# Local MCP config (per-machine)
.mcp.json
