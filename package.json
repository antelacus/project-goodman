{
  "name": "project-goodman",
  "version": "4.7.2",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "test:perf": "tsx scripts/quality-gates/perf-gate.ts check",
    "test:lighthouse": "lhci collect --config=./lighthouserc.cjs",
    "test:a11y": "tsx scripts/quality-gates/a11y-gate.ts check",
    "test:audit": "tsx scripts/quality-gates/audit-gate.ts",
    "test:lighthouse:gate": "npm run test:lighthouse && tsx scripts/quality-gates/lighthouse-gate.ts check",
    "perf:baseline": "tsx scripts/quality-gates/perf-gate.ts baseline",
    "a11y:baseline": "tsx scripts/quality-gates/a11y-gate.ts baseline",
    "lighthouse:baseline": "npm run test:lighthouse && tsx scripts/quality-gates/lighthouse-gate.ts baseline",
    "analyze": "ANALYZE=true npm run build",
    "migrate-data": "tsx scripts/migrate-to-supabase.ts",
    "migrate-data:dry-run": "tsx scripts/migrate-to-supabase.ts --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@langchain/core": "^1.1.7",
    "@langchain/langgraph": "^1.0.7",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/node": "^10.34.0",
    "@sentry/types": "^10.34.0",
    "@supabase/supabase-js": "^2.80.0",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.0",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "katex": "^0.16.22",
    "langsmith": "^0.10.4",
    "lucide-react": "^0.562.0",
    "mathjs": "^15.2.0",
    "next": "^16.4.3",
    "node-cron": "^4.2.1",
    "openai": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "unpdf": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "autocannon": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npx tsc --noEmit'"
    ]
  },
  "overrides": {
    "tmp": "^0.2.6",
    "basic-ftp": "^6.2.3"
  },
  "allowScripts": {
    "canvas@3.2.0": true,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
