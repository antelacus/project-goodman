# Project Goodman Staging Environment Variables Example
# Copy to /home/deploy/goodman-staging/.env.staging and fill in your values
# IMPORTANT: Use a dedicated Supabase staging project or isolated schema.

# =============================================================================
# LLM Configuration (the relay; the model is fixed in src/lib/ai/config.ts)
# =============================================================================
LLM_API_KEY="your-relay-api-key"
LLM_BASE_URL="https://your-relay.example.com/v1"

# =============================================================================
# Supabase Configuration (Staging)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-staging-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-staging-anon-key"

# Service role key for admin operations (migrations, DDL) - KEEP SECURE!
SUPABASE_SERVICE_ROLE_KEY="your-staging-service-role-key"

# =============================================================================
# Admin Configuration
# =============================================================================
# Password for admin features (structured data upload, database management)
# This password unlocks admin mode via easter egg trigger (triple-click on page header)
ADMIN_PASSWORD="your-admin-password"

# =============================================================================
# Redis Configuration (Staging)
# =============================================================================
# Required for rate limiting, session management, and brute-force protection
REDIS_HOST="goodman-redis-staging"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
# Set to "true" to disable Redis and use in-memory fallback only
# REDIS_DISABLED="false"

# =============================================================================
# LangSmith Configuration (Optional - Agent Observability)
# =============================================================================
# Enable tracing to LangSmith for agent workflow observability
# Set to "true" to enable, "false" or omit to disable
LANGCHAIN_TRACING_V2="false"
# API key from LangSmith dashboard (https://smith.langchain.com/)
LANGCHAIN_API_KEY=""
# Project name in LangSmith (defaults to "goodman-staging" if not set)
LANGCHAIN_PROJECT="goodman-staging"

# =============================================================================
# Sentry Error Tracking (Server Only)
# =============================================================================
SENTRY_DSN="https://public-key@oXXXX.ingest.sentry.io/XXXX"
SENTRY_ENV="staging"

# =============================================================================
# Environment
# =============================================================================
NODE_ENV="production"
